---
type: event
name: harness_pineapple
version: 1.0.0
description: Respond with a one-line pirate greeting when the word 'pineapple' is
  said.
target_agent: '*'
enabled: true
response: Ahoy, matey!
trigger:
  'on':
  - type: message
    match: pineapple
input_prompt: Ahoy, matey!
parameters:
  event:
    type: object
    required: false
    description: Trigger data
---
