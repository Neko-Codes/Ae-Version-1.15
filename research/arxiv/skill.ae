---
type: skill
name: arxiv_research
description: Search arXiv papers and retrieve academic papers via REST API
version: 1.0.0
parameters:
  action:
    type: string
    enum: [search, get_paper, search_by_author, search_by_category, get_citations, get_references, search_semantic_scholar, get_recommendations]
    required: true
    description: Action to perform
  query:
    type: string
    required: false
    description: Search query (for search action)
  arxiv_id:
    type: string
    required: false
    description: arXiv paper ID (for get_paper, get_citations, get_references)
  author:
    type: string
    required: false
    description: Author name (for search_by_author)
  category:
    type: string
    required: false
    description: arXiv category (for search_by_category, e.g., cs.AI)
  max_results:
    type: integer
    required: false
    default: 10
    description: Maximum results to return
  sort_by:
    type: string
    enum: [relevance, lastUpdatedDate, submittedDate]
    required: false
    default: relevance
  sort_order:
    type: string
    enum: [ascending, descending]
    required: false
    default: descending
  paper_ids:
    type: array
    items:
      type: string
    required: false
    description: List of paper IDs for batch operations
execute: |
  import urllib.request
  import urllib.parse
  import xml.etree.ElementTree as ET
  import json
  import sys

  action = params.get("action")
  max_results = params.get("max_results", 10)

  def fetch_arxiv(url):
      req = urllib.request.Request(url, headers={"User-Agent": "AE-Agent/1.0"})
      with urllib.request.urlopen(req, timeout=30) as resp:
          return resp.read().decode("utf-8")

  def parse_arxiv_xml(xml_text):
      ns = {'a': 'http://www.w3.org/2005/Atom'}
      root = ET.fromstring(xml_text)
      papers = []
      for entry in root.findall('a:entry', ns):
          title_elem = entry.find('a:title', ns)
          id_elem = entry.find('a:id', ns)
          published_elem = entry.find('a:published', ns)
          summary_elem = entry.find('a:summary', ns)
          
          title = title_elem.text.strip().replace('\n', ' ') if title_elem is not None else ""
          arxiv_id = id_elem.text.strip().split('/abs/')[-1] if id_elem is not None else ""
          published = published_elem.text[:10] if published_elem is not None else ""
          summary = summary_elem.text.strip()[:500] if summary_elem is not None else ""
          
          authors = []
          for author in entry.findall('a:author', ns):
              name_elem = author.find('a:name', ns)
              if name_elem is not None:
                  authors.append(name_elem.text)
          
          categories = []
          for cat in entry.findall('a:category', ns):
              term = cat.get('term')
              if term:
                  categories.append(term)
          
          papers.append({
              "title": title,
              "arxiv_id": arxiv_id,
              "published": published,
              "authors": authors,
              "summary": summary,
              "categories": categories,
              "pdf_url": f"https://arxiv.org/pdf/{arxiv_id}",
              "abs_url": f"https://arxiv.org/abs/{arxiv_id}"
          })
      return papers

  if action == "search":
      query = params.get("query", "")
      if not query:
          return_value = {"error": "query parameter required for search"}
      else:
          encoded = urllib.parse.quote(query)
          url = f"http://export.arxiv.org/api/query?search_query={encoded}&max_results={params.get('max_results', 10)}&sortBy={params.get('sort_by', 'relevance')}&sortOrder={params.get('sort_order', 'descending')}"
          xml_text = fetch_arxiv(url)
          papers = parse_arxiv_xml(xml_text)
          return_value = {"papers": papers, "count": len(papers)}

  elif action == "get_paper":
      arxiv_id = params.get("arxiv_id")
      if not arxiv_id:
          return_value = {"error": "arxiv_id required for get_paper"}
      else:
          url = f"http://export.arxiv.org/api/query?id_list={arxiv_id}"
          xml_text = fetch_arxiv(url)
          papers = parse_arxiv_xml(xml_text)
          return_value = {"papers": papers, "count": len(papers)}

  elif action == "search_by_author":
      author = params.get("author")
      if not author:
          return_value = {"error": "author parameter required"}
      else:
          query = f"au:{author}"
          encoded = urllib.parse.quote(query)
          url = f"http://export.arxiv.org/api/query?search_query={encoded}&max_results={max_results}"
          xml_text = fetch_arxiv(url)
          papers = parse_arxiv_xml(xml_text)
          return_value = {"papers": papers, "count": len(papers)}

  elif action == "search_by_category":
      category = params.get("category")
      if not category:
          return_value = {"error": "category parameter required"}
      else:
          query = f"cat:{category}"
          encoded = urllib.parse.quote(query)
          url = f"http://export.arxiv.org/api/query?search_query={encoded}&max_results={max_results}&sortBy=submittedDate&sortOrder=descending"
          xml_text = fetch_arxiv(url)
          papers = parse_arxiv_xml(xml_text)
          return_value = {"papers": papers, "count": len(papers)}

  elif action == "get_citations":
      arxiv_id = params.get("arxiv_id")
      if not arxiv_id:
          return_value = {"error": "arxiv_id required"}
      else:
          # Use Semantic Scholar API for citations
          url = f"https://api.semanticscholar.org/graph/v1/paper/arXiv:{arxiv_id}/citations?fields=title,authors,year,citationCount&limit=20"
          try:
              req = urllib.request.Request(url, headers={"User-Agent": "AE-Agent/1.0"})
              with urllib.request.urlopen(req, timeout=30) as resp:
                  data = json.loads(resp.read().decode("utf-8"))
              return_value = {"citations": data.get("data", []), "total": data.get("total", 0)}
          except Exception as e:
              return_value = {"error": f"Failed to fetch citations: {str(e)}"}

  elif action == "get_references":
      arxiv_id = params.get("arxiv_id")
      if not arxiv_id:
          return_value = {"error": "arxiv_id required"}
      else:
          url = f"https://api.semanticscholar.org/graph/v1/paper/arXiv:{arxiv_id}/references?fields=title,authors,year,citationCount&limit=20"
          try:
              req = urllib.request.Request(url, headers={"User-Agent": "AE-Agent/1.0"})
              with urllib.request.urlopen(req, timeout=30) as resp:
                  data = json.loads(resp.read().decode("utf-8"))
              return_value = {"references": data.get("data", []), "total": data.get("total", 0)}
          except Exception as e:
              return_value = {"error": f"Failed to fetch references: {str(e)}"}

  elif action == "search_semantic_scholar":
      query = params.get("query")
      if not query:
          return_value = {"error": "query required"}
      else:
          encoded = urllib.parse.quote(query)
          url = f"https://api.semanticscholar.org/graph/v1/paper/search?query={encoded}&limit={max_results}&fields=title,authors,year,citationCount,externalIds"
          try:
              req = urllib.request.Request(url, headers={"User-Agent": "AE-Agent/1.0"})
              with urllib.request.urlopen(req, timeout=30) as resp:
                  data = json.loads(resp.read().decode("utf-8"))
              return_value = {"papers": data.get("data", []), "total": data.get("total", 0)}
          except Exception as e:
              return_value = {"error": f"Semantic Scholar search failed: {str(e)}"}

  elif action == "get_recommendations":
      paper_ids = params.get("paper_ids", [])
      if not paper_ids:
          return_value = {"error": "paper_ids array required"}
      else:
          url = "https://api.semanticscholar.org/recommendations/v1/papers/"
          payload = json.dumps({"positivePaperIds": [f"arXiv:{pid}" for pid in paper_ids], "negativePaperIds": []})
          req = urllib.request.Request(url, data=payload.encode("utf-8"), 
                                      headers={"Content-Type": "application/json", "User-Agent": "AE-Agent/1.0"}, method="POST")
          try:
              with urllib.request.urlopen(req, timeout=30) as resp:
                  data = json.loads(resp.read().decode("utf-8"))
              return_value = {"recommendations": data.get("recommendedPapers", [])}
          except Exception as e:
              return_value = {"error": f"Recommendations failed: {str(e)}"}

  else:
      return_value = {"error": f"Unknown action: {action}"}
---