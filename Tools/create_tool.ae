---
type: tool
name: create_tool
version: 1.0.0
description: Create a new AEX tool script in AutomatableExecutables/Tools/. Requires user approval. This tool is itself an editable .ae file.
parameters:
  name:
    type: string
    required: true
    description: Tool name (letters, numbers, underscore, hyphen).
  description:
    type: string
    required: true
    description: What the tool does.
  category:
    type: string
    required: false
    description: Category folder (e.g. 'core', 'web', 'file'). Default 'uncategorized'.
  parameters:
    type: object
    required: true
    description: "AEX-style params like arg: {type, required, description}, or JSON-Schema with properties/required."
  execute_code:
    type: string
    required: true
    description: "Python body (return_value, no bare return). Has params, call_tool (tools+skills), call_skill, call_builtin, json. call_tool('skill', ...) reaches skills."
  scope:
    type: string
    required: false
    description: "'local' (default, this agent only), 'shared' (all agents), or 'global'."
execute: |
  import re
  import yaml
  name = params["name"]
  if not re.fullmatch(r"[a-zA-Z0-9_-]+", name):
      raise ValueError("Tool name must contain only letters, numbers, underscores, or hyphens.")
  category = params.get("category") or "uncategorized"
  if not re.fullmatch(r"[a-zA-Z0-9_.-]+", category):
      raise ValueError("Category must contain only letters, numbers, underscores, or hyphens.")
  scope = params.get("scope")
  _scope = ({"scope": scope} if scope else {})
  parameters = params.get("parameters") or {}
  if not isinstance(parameters, dict):
      raise ValueError("parameters must be an object.")
  if "properties" in parameters and isinstance(parameters["properties"], dict):
      req = set(parameters.get("required", []) or [])
      norm = {}
      for pname, pdef in parameters["properties"].items():
          if not isinstance(pdef, dict):
              pdef = {"type": "string"}
          norm[pname] = {"type": pdef.get("type", "string"), "required": pname in req, "description": pdef.get("description", "")}
      parameters = norm
  code = params["execute_code"]
  # Auto-repair: bare `return X` at module level -> `return_value = X`
  # (execute bodies have no enclosing function). Bounded, then verified.
  import re as _re2
  for _ in range(6):
      try:
          compile(code, f"<tool:{name}>", "exec")
          break
      except SyntaxError as ex:
          _msg, _ln = str(ex), getattr(ex, "lineno", None)
          _lines = code.splitlines()
          if "return" in _msg and "outside function" in _msg and _ln and 1 <= _ln <= len(_lines):
              _line = _lines[_ln - 1]
              _m = _re2.match(r"^(\s*)return(?![\w_])", _line)
              if _m and not _line.strip().startswith("return_value"):
                  _rest = _line[_m.end():].strip()
                  _lines[_ln - 1] = f"{_m.group(1)}return_value = {_rest if _rest else 'None'}"
                  code = "\n".join(_lines)
                  continue
          raise ValueError(
              f"Invalid Python in execute_code: {ex}. Execute bodies run at MODULE level: "
              "never use bare `return`; assign `return_value = ...` instead. "
              "Minimal example:\n"
              "execute_code: \"text = params['text']\\nreturn_value = text[::-1]\"")
  # Static name check. `compile()` only proves the SYNTAX is valid; a bare
  # identifier that is never assigned still raises NameError at RUNTIME, long
  # after creation. That is the exact failure this prevents: writing
  # `html_content` instead of `params["html_content"]`, which yields a tool
  # that is permanently broken and gets retried every turn.
  import ast as _ast
  import builtins as _builtins
  _SANDBOX = {
      "params", "parameters", "data", "workspace", "memory", "agent_name", "tools",
      "skills", "events", "config", "context", "datetime", "time", "json", "call_tool",
      "call_builtin", "call_skill", "load_skill", "emit_event", "spawn_agent",
      "send_message", "wait_for_event", "retain", "recall", "tool_history", "exec_id",
      "should_stop", "report", "return_value", "body", "__name__", "__file__", "__doc__",
  }
  try:
      _tree = _ast.parse(code)
  except SyntaxError as ex:
      raise ValueError(f"execute_code does not parse: {ex}")
  _bound, _loaded = set(), set()
  for _n in _ast.walk(_tree):
      if isinstance(_n, _ast.Name):
          if isinstance(_n.ctx, (_ast.Store, _ast.Del)):
              _bound.add(_n.id)
          else:
              _loaded.add(_n.id)
      elif isinstance(_n, (_ast.FunctionDef, _ast.AsyncFunctionDef, _ast.ClassDef)):
          _bound.add(_n.name)
      elif isinstance(_n, _ast.arg):
          _bound.add(_n.arg)
      elif isinstance(_n, (_ast.Import, _ast.ImportFrom)):
          for _a in _n.names:
              _bound.add((_a.asname or _a.name).split(".")[0])
      elif isinstance(_n, _ast.ExceptHandler):
          if _n.name:
              _bound.add(_n.name)
      elif isinstance(_n, (_ast.Global, _ast.Nonlocal)):
          _bound.update(_n.names)
  _known = set(dir(_builtins)) | _SANDBOX | {"self", "cls"}
  _undefined = sorted(_loaded - _bound - _known)
  if _undefined:
      _declared = set(parameters.keys()) if isinstance(parameters, dict) else set()
      _paramish = [u for u in _undefined if u in _declared]
      _hint = ""
      if _paramish:
          _hint = (" Parameters are NOT auto-bound into scope - read each one as "
                   + ", ".join("params[\"" + p + "\"]" for p in _paramish) + ".")
      raise ValueError(
          "execute_code references undefined name(s): " + ", ".join(_undefined)
          + ". Nothing injects those into the execute scope, so this tool would raise "
          "NameError on every call." + _hint)

  # Structural check: the assembled file must parse as an .ae tool.
  try:
      _meta_check = {"type": "tool", "name": name, "version": "1.0.0", "description": params["description"], "parameters": parameters, "execute": code}
      assert isinstance(_meta_check["execute"], str) and _meta_check["execute"].strip()
      assert isinstance(_meta_check["parameters"], dict)
  except Exception as ex:
      raise ValueError(f"Tool definition is structurally invalid: {ex}")
  path = f"Tools/{category}/{name}.ae"
  try:
      call_builtin("ae_read", path=path, **_scope)
      raise ValueError(f"Tool already exists: {path}. Choose another name or category.")
  except ValueError as ex:
      if "already exists" in str(ex):
          raise
  metadata = {"type": "tool", "name": name, "version": "1.0.0", "description": params["description"],
              "category": category, "parameters": parameters, "execute": code}
  content = "---\n" + yaml.safe_dump(metadata, sort_keys=False, allow_unicode=True) + "---\n"
  saved = call_builtin("ae_write", path=path, content=content, **_scope)
  return_value = {"saved": saved, "name": name,
                  "invoke": f"Call {name} DIRECTLY by name as a function call starting next round (it is a TOOL, not a skill/executable — do NOT use run_skill or run_executable for it). Test it with real arguments immediately."}
---
